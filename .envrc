# direnv: dev shell environment for sarmata. Run `direnv allow` once per worktree.

# sops on macOS looks in ~/Library/Application Support, the team key lives in ~/.config.
export SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"

# Workspace binaries (turbo, eslint, prettier, supabase) without the pnpm exec prefix.
PATH_add node_modules/.bin

# .env.local is never committed. It is decrypted from secrets/dev.enc.env (SOPS) whenever the
# encrypted file is newer or .env.local is missing, then loaded into the shell.
watch_file secrets/dev.enc.env
if [ secrets/dev.enc.env -nt .env.local ]; then
  if [ -f "$SOPS_AGE_KEY_FILE" ] && has sops; then
    bash scripts/secrets-decrypt.sh >&2 || log_error "sops decrypt failed, run pnpm secrets:decrypt"
  else
    log_error "no age key or sops, .env.local not decrypted (run pnpm run doctor)"
  fi
fi
dotenv_if_exists .env.local
