{
  "name": "sarmata",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @sarmata/web dev",
    "web:env": "node scripts/web-env.mjs",
    "e2e": "pnpm --filter @sarmata/e2e e2e",
    "e2e:ui": "pnpm --filter @sarmata/e2e e2e:ui",
    "e2e:walk": "pnpm --filter @sarmata/e2e walk",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && turbo run typecheck test",
    "prepare": "husky",
    "doctor": "bash scripts/doctor.sh",
    "secrets:decrypt": "bash scripts/secrets-decrypt.sh",
    "db:start": "pnpm --filter @sarmata/database start",
    "db:stop": "pnpm --filter @sarmata/database stop",
    "db:status": "pnpm --filter @sarmata/database status",
    "db:reset": "pnpm --filter @sarmata/database reset && pnpm regulations:sync && pnpm db:seed:demo",
    "regulations:sync": "node scripts/with-supabase-env.mjs pnpm --filter @sarmata/worker sync-regulations",
    "db:seed:demo": "node scripts/with-supabase-env.mjs pnpm --filter @sarmata/services seed-demo-evaluations",
    "worker:start": "node scripts/with-supabase-env.mjs pnpm --filter @sarmata/worker start",
    "worker:dev": "node scripts/with-supabase-env.mjs pnpm --filter @sarmata/worker dev",
    "db:types": "pnpm --filter @sarmata/database types",
    "db:test": "pnpm --filter @sarmata/database test:db",
    "test:integration": "node scripts/with-supabase-env.mjs pnpm --filter @sarmata/repositories test:integration",
    "ai:setup": "pnpm --filter @sarmata/ai-runtime ai:setup",
    "ai:env": "pnpm --filter @sarmata/ai-runtime ai:env",
    "ai:start": "pnpm --filter @sarmata/ai-runtime ai:start",
    "ai:stop": "pnpm --filter @sarmata/ai-runtime ai:stop"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "catalog:",
    "typescript-eslint": "8.73.0"
  }
}
