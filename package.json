{
  "name": "sarmata",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && turbo run typecheck test",
    "prepare": "husky",
    "doctor": "bash scripts/doctor.sh",
    "secrets:decrypt": "bash scripts/secrets-decrypt.sh",
    "db:start": "pnpm --filter @sarmata/database start",
    "db:stop": "pnpm --filter @sarmata/database stop",
    "db:status": "pnpm --filter @sarmata/database status",
    "db:reset": "pnpm --filter @sarmata/database reset",
    "db:types": "pnpm --filter @sarmata/database types",
    "db:test": "pnpm --filter @sarmata/database test:db"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "catalog:",
    "typescript-eslint": "8.73.0"
  }
}
